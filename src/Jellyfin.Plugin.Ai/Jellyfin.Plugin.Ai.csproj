<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Ai</RootNamespace>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <!-- Copy the SDK and its dependencies next to the plugin, so the release zip can include them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime: compile against them, don't ship them -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official Anthropic SDK (MIT), shipped beside the plugin with its two dependencies (see build.yaml) -->
    <PackageReference Include="Anthropic" Version="12.50.0" />
  </ItemGroup>

  <!-- Shared source (resilience, budgets, spend tracking), compiled in as internal code; see external/common -->
  <Import Project="../../external/common/Common.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Ai.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Pricing\prices.json" />
  </ItemGroup>

</Project>
